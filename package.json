{
  "name": "teamlaunch",
  "version": "1.0.13",
  "private": true,
  "type": "module",
  "description": "TeamLaunch - Windows 桌面端团队统一入口启动器",
  "license": "MIT",
  "author": "JiuZhang-9",
  "homepage": "https://github.com/JiuZhang-9/teamlaunch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiuZhang-9/teamlaunch.git"
  },
  "bugs": {
    "url": "https://github.com/JiuZhang-9/teamlaunch/issues"
  },
  "main": "dist/main/index.cjs",
  "postinstall": "node scripts/patch-builder.cjs",
  "scripts": {
    "dev": "vite",
    "dev:detached": "npx vite --port 5180 --strictPort",
    "build": "npm run build:renderer && npm run build:preload && npm run build:main",
    "build:renderer": "vite build",
    "build:preload": "vite build -c vite.preload.config.ts",
    "build:main": "vite build -c vite.main.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "electron:dev": "node scripts/run-electron.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "verify:p0": "python docs/design-system/scan-p0.py",
    "verify:tokens": "python docs/design-system/validate-tokens.py",
    "verify:icons": "node docs/design-system/verify-lucide-exports.mjs",
    "verify:openapi": "node scripts/verify-openapi.cjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:deps": "node scripts/verify-deps.mjs",
    "verify:all": "npm run verify:p0 && npm run verify:tokens && npm run verify:icons && npm run verify:openapi && npm run verify:schema && npm run verify:deps && npm run guard:server && npm run smoke:server && npm run verify:sync && npm run verify:wiring",
    "smoke:server": "node --experimental-transform-types scripts/smoke-server.mjs",
    "verify:wiring": "node --experimental-transform-types scripts/verify-main-wiring.mjs",
    "verify:sync": "node --experimental-transform-types scripts/verify-sync-client.mjs",
    "guard:server": "node scripts/guard-server.mjs",
    "verify:qa-channels": "node scripts/verify-qa-ipc-channels.mjs",
    "verify:qa-port": "node --experimental-transform-types scripts/verify-qa-port-contract.mjs",
    "verify:qa-http": "node --experimental-transform-types scripts/verify-qa-http-gates.mjs",
    "verify:qa-personal": "node --experimental-transform-types scripts/verify-qa-personal-port.mjs",
    "verify:qa-import": "node --experimental-transform-types scripts/verify-qa-import-consistency.mjs",
    "verify:qa-sync": "node --experimental-transform-types scripts/verify-qa-sync-gates.mjs",
    "verify:qa": "npm run verify:qa-channels && npm run verify:qa-personal && npm run verify:qa-import && npm run verify:qa-sync && npm run verify:qa-port && npm run verify:qa-http"
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "fastify": "5.12.5",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "js-yaml": "4.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
