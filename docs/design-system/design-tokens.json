  "a11y": {
    "minTouchTarget": "32px",
    "minRowHeight": "44px",
    "focusRingComposite": "0 0 0 2px {semantic.bg.surface}, 0 0 0 4px {semantic.accent.focusRing}",
    "supportedScale": [
      "100%",
      "125%",
      "150%"
    ],
    "target": "WCAG 2.1 AA",
    "reducedMotion": {
      "query": "prefers-reduced-motion: reduce",
      "rules": [
        "所有 transition / animation 时长降为 0.01ms",
        "循环类动画（--motion-loop / --motion-breathe）必须停止，不是变快",
        "[data-motion=\"loop\"] 直接 animation: none，改用静态替代形态",
        "scroll-behavior 强制为 auto"
      ],
      "tokenOverrides": {
        "motion.instant": "0ms",
        "motion.fast": "0ms",
        "motion.base": "0ms",
        "motion.slow": "0ms",
        "motion.loop": "0ms",
        "motion.breathe": "0ms"
      }
    },
    "forcedColors": {
      "query": "forced-colors: active",
      "rules": [
        "表面统一为 Canvas，文本统一为 CanvasText",
        "强调色映射 Highlight / HighlightText，链接色 LinkText",
        "焦点环改为 3px Highlight",
        "全部 box-shadow 置 none，层级改用 1px CanvasText 边框",
        "同步 8 态、反馈 3 态、入口类型不得只靠颜色：点形态 + 图标 + 文案三重通道保留",
        "禁止对图标使用 forced-color-adjust: none"
      ],
      "tokenOverrides": {
        "bg.canvas": "Canvas",
        "bg.surface": "Canvas",
        "fg.default": "CanvasText",
        "fg.secondary": "CanvasText",
        "fg.muted": "CanvasText",
        "fg.disabled": "GrayText",
        "border.default": "CanvasText",
        "accent.default": "Highlight",
        "accent.on": "HighlightText",
        "accent.text": "LinkText",
        "accent.focusRing": "Highlight",
        "elevation.1": "none",
        "elevation.2": "none",
        "elevation.3": "none"
      }
    }
  },
  "icons": {
    "library": "Lucide",
    "license": "ISC",
    "grid": 24,
    "strokeWidth": 2,
    "capJoin": "round",
    "colorStrategy": "currentColor",
    "sizes": [
      12,
